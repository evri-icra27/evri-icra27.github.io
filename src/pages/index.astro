---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import EventStream from '~/components/workshop/EventStream.astro';
import Features from '~/components/widgets/Features.astro';
import Button from '~/components/ui/Button.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { SITE, I18N } from 'astrowind:config';
import { workshop, topics } from '~/data/workshop';
import { getPermalink } from '~/utils/permalinks';

const metadata = { title: `${workshop.title} — ICRA 2027`, ignoreTitleTemplate: true };
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.site,
  inLanguage: I18N.language,
};
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={structuredData} />
  {/* Hero renders its bg slot as an HTML string, which would drop the banner's script. */}
  <div class="relative">
    <EventStream />
    <Hero
      badge={workshop.status}
      tagline={workshop.conference}
      title={workshop.title}
      subtitle={workshop.subtitle}
      actions={[
        { text: 'Explore the program', href: getPermalink('/program'), variant: 'primary' },
        { text: 'Call for papers', href: getPermalink('/call-for-papers') },
      ]}
    >
      <Fragment slot="content">
        <p class="mt-8 text-sm text-muted">{workshop.location} · Proposed full-day workshop · Date to be confirmed</p>
      </Fragment>
    </Hero>
  </div>

  <section class="border-y border-slate-200 bg-slate-50 py-12 dark:border-slate-800 dark:bg-slate-900/50">
    <div class="mx-auto max-w-4xl px-4 sm:px-6">
      <h2 class="mb-5 text-2xl font-bold text-heading md:text-3xl">From event streams to robot action</h2>
      <p class="text-lg leading-relaxed text-muted">
        How can event-based vision help robots perceive, reason, and act in the real world? This proposed workshop
        brings together researchers in robotics, computer vision, neuromorphic computing, and embodied AI to explore
        that question—from agile state estimation and autonomous driving to learning and manipulation.
      </p>
      <p class="mt-4 text-lg leading-relaxed text-muted">
        We are planning a day of tutorials, invited talks, contributed research, benchmark challenges, and robot
        demonstrations, with space for discussion across these communities.
      </p>
    </div>
  </section>

  <Features
    title="Workshop themes"
    subtitle="Connecting sensing, perception, reasoning, and action."
    items={topics}
    columns={3}
  />

  <section class="mx-auto max-w-4xl px-4 pb-16 sm:px-6 md:pb-24">
    <div class="rounded-2xl border border-slate-200 p-6 md:p-10 dark:border-slate-700">
      <h2 class="mb-3 text-2xl font-bold text-heading">Help shape the discussion</h2>
      <p class="mb-6 leading-relaxed text-muted">
        We plan to welcome short papers and demo contributions across the workshop themes. Submission instructions and
        important dates will be announced once the workshop is confirmed.
      </p>
      <div class="flex flex-wrap gap-4">
        <Button href={getPermalink('/call-for-papers')} variant="primary">Contribution details</Button>
        <Button href={getPermalink('/organisers')}>Meet the organisers</Button>
      </div>
    </div>
  </section>
</Layout>
