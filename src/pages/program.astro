---
import Layout from '~/layouts/PageLayout.astro';
import PageIntro from '~/components/workshop/PageIntro.astro';

const sessions = [
  {
    title: 'Tutorial & invited talks',
    description:
      'An introduction to event cameras for roboticists, followed by talks spanning perception, state estimation, and embodied intelligence.',
  },
  {
    title: 'Contributed research',
    description: 'Short oral presentations and posters highlighting work from the community.',
  },
  {
    title: 'Benchmark challenges',
    description:
      'Planned challenges in event-based SLAM, time-to-contact estimation, and 3D detection for autonomous driving.',
  },
  {
    title: 'Robot & system demonstrations',
    description: 'A chance to share working systems and discuss practical lessons from deployment.',
  },
  {
    title: 'Panel & open discussion',
    description: 'A closing conversation about the opportunities and challenges for event-driven robotics.',
  },
];
---

<Layout metadata={{ title: 'Program', description: 'The proposed format for the EVRI workshop at ICRA 2027.' }}>
  <PageIntro
    title="Program"
    description="A proposed full-day workshop, connecting event-based sensing with real-world robotic perception and action."
  />
  <section class="mx-auto max-w-4xl px-4 pb-16 sm:px-6 md:pb-24" aria-labelledby="format-title">
    <p class="mb-10 rounded-xl bg-slate-100 p-5 text-muted dark:bg-slate-800">
      The workshop date, room, and detailed timetable will be announced following confirmation.
    </p>
    <h2 id="format-title" class="mb-6 text-2xl font-bold text-heading">Planned format</h2>
    <ul class="divide-y divide-slate-200 dark:divide-slate-800">
      {
        sessions.map(({ title, description }) => (
          <li class="py-6 first:pt-0">
            <h3 class="mb-2 text-xl font-semibold text-heading">{title}</h3>
            <p class="leading-relaxed text-muted">{description}</p>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>
