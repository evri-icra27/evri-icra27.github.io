---
import Layout from '~/layouts/PageLayout.astro';
import PageIntro from '~/components/workshop/PageIntro.astro';
import { speakers } from '~/data/workshop';
---

<Layout
  metadata={{
    title: 'Speakers',
    description: 'Confirmed invited speakers for the proposed EVRI workshop at ICRA 2027.',
  }}
>
  <PageIntro
    title="Speakers"
    description="Perspectives from event-based vision, robotics, neuromorphic computing, and embodied AI."
  />
  <section class="mx-auto max-w-4xl px-4 pb-16 sm:px-6 md:pb-24" aria-labelledby="speakers-title">
    <h2 id="speakers-title" class="mb-6 text-2xl font-bold text-heading">Confirmed speakers</h2>
    <ul class="divide-y divide-slate-200 dark:divide-slate-800">
      {
        speakers.map(({ name, affiliation, topic }) => (
          <li class="py-5 first:pt-0">
            <h3 class="text-lg font-semibold text-heading">{name}</h3>
            <p class="text-sm text-muted">{affiliation}</p>
            <p class="mt-1 leading-relaxed">{topic}</p>
          </li>
        ))
      }
    </ul>
    <p class="mt-8 text-muted">Further speakers and panellists will be announced.</p>
  </section>
</Layout>
